{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "NewsArticle"
    }
  },
  "description": "\u041f\u0440\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u0438 \u043d\u043e\u0432\u043e\u0441\u0442\u0438 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u041d\u043e\u0432\u043e\u0441\u0442\u0438\u00bb \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u043f\u0438\u0441\u044c\u043c\u043e \u0432\u0441\u0435\u043c \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u043f\u043e\u0434\u043f\u0438\u0441\u0447\u0438\u043a\u0430\u043c",
  "name": "Newsletter on News",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "newsletter_on_news",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_newsletter": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendNewsletter",
            "args": {
              "article_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u041e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0440\u0430\u0441\u0441\u044b\u043b\u043a\u0443 \u043f\u043e\u0434\u043f\u0438\u0441\u0447\u0438\u043a\u0430\u043c",
            "description": "\u041f\u0438\u0441\u044c\u043c\u043e \u043f\u043e \u043d\u043e\u0432\u043e\u0439 \u043d\u043e\u0432\u043e\u0441\u0442\u0438"
          }
        }
      }
    ]
  }
}