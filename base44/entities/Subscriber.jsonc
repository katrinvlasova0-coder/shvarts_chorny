{
  "name": "Subscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email \u043f\u043e\u0434\u043f\u0438\u0441\u0447\u0438\u043a\u0430 (Gmail \u0438 \u0434\u0440.)"
    },
    "name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u043f\u043e\u0434\u043f\u0438\u0441\u0447\u0438\u043a\u0430 (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e)"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "subscribedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "description": "\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438"
    }
  },
  "required": [
    "email"
  ]
}